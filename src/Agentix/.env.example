# LLM Provider
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Agentix Settings
AGENTIX_MAX_ITERATIONS=10
AGENTIX_SANDBOX_ENABLED=true
AGENTIX_LOG_LEVEL=INFO

# Memory
AGENTIX_MEMORY_BACKEND=inmemory   # inmemory | redis | postgres
REDIS_URL=redis://localhost:6379

# Integrations / Providers
SIEM_PROVIDER=wazuh
CASE_MANAGEMENT_PROVIDER=thehive
ENRICHMENT_PROVIDER=cortex
SOAR_PROVIDER=dummy
ENDPOINT_PROVIDER=wazuh
FIREWALL_PROVIDER=dummy
IAM_PROVIDER=dummy

# SOC Tools Integration
THEHIVE_URL=http://localhost:9000
THEHIVE_API_KEY=your_thehive_analyst_api_key
# Admin keys for TheHive setup scripts (not used in runtime agents)
THEHIVE_ADMIN_API_KEY=your_thehive_admin_api_key
THEHIVE_SOC_ADMIN_KEY=your_thehive_soc_admin_api_key

WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=wazuh-wui
WAZUH_API_VERIFY_SSL=false

ELASTICSEARCH_URL=https://localhost:9200
ELASTICSEARCH_USER=admin
ELASTICSEARCH_PASSWORD=admin

IDM_API_URL=http://localhost:8081
IDM_API_KEY=your_idm_api_key

FIREWALL_API_URL=http://localhost:8082
FIREWALL_API_KEY=your_firewall_api_key

CORTEX_URL=http://localhost:9001
CORTEX_API_KEY=your_cortex_api_key
CORTEX_IP_ANALYZERS=VirusTotal_GetReport_3_1,AbuseIPDB_2_0
CORTEX_FILE_ANALYZERS=VirusTotal_GetReport_3_1
CORTEX_DOMAIN_ANALYZERS=VirusTotal_GetReport_3_1
