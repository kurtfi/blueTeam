# ==============================================================================
# Agentix Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Core & Security Settings
# ------------------------------------------------------------------------------
AGENTIX_LOG_LEVEL=INFO
AGENTIX_WORKSPACE_ROOT=.
# Internal API key used for Gateway <-> Core communication
AGENTIX_INTERNAL_API_KEY=dev-internal-key-change-me-in-production
# External URL of the Agentix Core API
AGENTIX_API_URL=http://localhost:8000
# Webhook secret key for verifying signature from Wazuh (or other integrations)
AGENTIX_WEBHOOK_SECRET=your-webhook-secret-here

# ------------------------------------------------------------------------------
# LLM Providers Configuration
# ------------------------------------------------------------------------------
# Active providers (openai | gemini | ollama)
AGENTIX_LLM_PROVIDER=ollama
AGENTIX_EMBEDDING_PROVIDER=ollama
AGENTIX_VECTOR_STORE=inmemory
AGENTIX_POSTGRES_URL=postgresql+asyncpg://agentix:password@localhost:25432/agentix_db

# OpenAI Settings
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Gemini Settings
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# Orchestrator & RAG Settings
# ------------------------------------------------------------------------------
AGENTIX_MAX_ITERATIONS=10
AGENTIX_SANDBOX_ENABLED=true
AGENTIX_RAG_ENABLED=true
AGENTIX_RAG_TOP_K=5
# SOC / TriageCore MCP SSE endpoint
AGENTIX_TRIAGE_CORE_URL=http://localhost:8081/sse

# ------------------------------------------------------------------------------
# Memory & Redis Settings
# ------------------------------------------------------------------------------
AGENTIX_MEMORY_BACKEND=inmemory   # inmemory | redis | postgres
REDIS_URL=redis://localhost:26379

# ------------------------------------------------------------------------------
# Session Workspace Settings
# ------------------------------------------------------------------------------
AGENTIX_SESSION_WORKSPACE_ENABLED=true
AGENTIX_SESSION_WORKSPACE_ROOT=
AGENTIX_SESSION_QUOTA_MB=100
AGENTIX_SESSION_TTL_HOURS=24
AGENTIX_SESSION_CLEANUP_ON_EXPIRE=true
AGENTIX_SESSION_DESTROY_ON_EXPIRE=false

# ------------------------------------------------------------------------------
# Messaging & Notification Channels
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
SLACK_BOT_TOKEN=your-slack-bot-token-here

# Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_FROM_NUMBER=your-twilio-from-number-here
TWILIO_WHATSAPP_FROM=your-twilio-whatsapp-from-here

# ------------------------------------------------------------------------------
# Mail Settings
# ------------------------------------------------------------------------------
AGENTIX_MAIL_PROVIDER=smtp  # smtp | sendgrid
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=agentix@test.local
SENDGRID_API_KEY=your-sendgrid-api-key-here

# ------------------------------------------------------------------------------
# Observability (Langfuse)
# ------------------------------------------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_HOST=http://localhost:3010

# ------------------------------------------------------------------------------
# Docker-Compose Internal Settings
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET=your-nextauth-secret-here
SALT=your-salt-here
TAVILY_API_KEY=your-tavily-api-key-here
FIREBASE_CREDENTIALS=secrets/agentix-firebase-adminsdk.json
FIREBASE_WEB_API_KEY=your-firebase-web-api-key-here

# ------------------------------------------------------------------------------
# Gateway Settings
# ------------------------------------------------------------------------------
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
GATEWAY_JWT_SECRET=dev-jwt-secret-key-1234567890-change-in-production
GATEWAY_ACCESS_TOKEN_EXPIRE_MINUTES=1440
GATEWAY_USERNAME=admin
GATEWAY_PASSWORD=admin123
