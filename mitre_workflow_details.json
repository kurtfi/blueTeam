    {
      "app_name": "Shuffle Tools",
      "app_version": "1.2.0",
      "description": "Extracts rule_id, description, agent_id, agent_ip, and MITRE technique from the incoming Wazuh alert.",
      "app_id": "deb7e113-7e77-4f5c-9ebe-857e41c7fb0d",
      "errors": null,
      "id": "step_1_parse_alert",
      "is_valid": true,
      "sharing": true,
      "label": "parse_alert",
      "public": true,
      "generated": false,
      "environment": "Shuffle",
      "name": "Parse Wazuh Alert",
      "parameters": [
        {
          "description": "",
          "id": "",
          "name": "code",
          "example": "",
          "value": "import json\nalert = json.loads(\"$exec\")\nrule_id = alert.get('rule', {}).get('id', 'unknown')\nrule_desc = alert.get('rule', {}).get('description', 'No description')\nmitre_ids = alert.get('rule', {}).get('mitre', {}).get('id', [])\nmitre_tactic = alert.get('rule', {}).get('mitre', {}).get('tactic', [])\nagent_id = alert.get('agent', {}).get('id', '000')\nagent_ip = alert.get('agent', {}).get('ip', alert.get('data', {}).get('srcip', ''))\nagent_name = alert.get('agent', {}).get('name', 'unknown')\ntimestamp = alert.get('timestamp', '')\nresult = {\n    'rule_id': rule_id,\n    'rule_desc': rule_desc,\n    'mitre_ids': mitre_ids,\n    'mitre_tactic': mitre_tactic,\n    'agent_id': agent_id,\n    'agent_ip': agent_ip,\n    'agent_name': agent_name,\n    'timestamp': timestamp,\n    'is_credential_dump': '100002' in str(rule_id) or 'T1003' in str(mitre_ids),\n    'is_reverse_shell': '100003' in str(rule_id) or 'T1059' in str(mitre_ids)\n}\nprint(json.dumps(result))",
          "multiline": false,
          "multiselect": false,
          "options": null,
          "action_field": "",
          "variant": "",
          "required": false,
          "configuration": false,
          "tags": null,
