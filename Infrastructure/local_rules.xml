<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <rule id="100002" level="10">
    <if_sid>1002</if_sid>
    <match>MITRE-ATTACK-SIM: T1003.008</match>
    <description>MITRE ATT&amp;CK T1003.008 - OS Credential Dumping (/etc/shadow access)</description>
    <group>mitre_t1003,syslog,errors,</group>
  </rule>

  <rule id="100003" level="10">
    <if_sid>1002</if_sid>
    <match>MITRE-ATTACK-SIM: T1059.004</match>
    <description>MITRE ATT&amp;CK T1059.004 - Command and Scripting Interpreter (Unix Shell / Reverse Shell)</description>
    <group>mitre_t1059,syslog,errors,</group>
  </rule>

  <!-- Her bireysel T1110 log satırını yakalar ama webhook'a gönderilmez (group listesinden authentication_failures kaldırıldı) -->
  <rule id="100010" level="3">
    <if_sid>1002</if_sid>
    <match>MITRE-ATTACK-SIM: T1110</match>
    <description>MITRE ATT&amp;CK T1110 - Brute Force (individual event)</description>
    <group>authentication_failed,syslog,</group>
  </rule>

  <!-- 60 saniye içinde 5+ T1110 event'i → TEK bir yüksek-seviye alert (webhook'a gönderilir) -->
  <rule id="100011" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100010</if_matched_sid>
    <description>MITRE ATT&amp;CK T1110 - Brute Force Attack Detected (correlated)</description>
    <group>authentication_failures,authentication_failed,syslog,errors,</group>
  </rule>

  <!-- Başarılı brute force girişini yakalar ve webhook'a gönderilmesini sağlar -->
  <rule id="100012" level="10">
    <if_sid>100010</if_sid>
    <match>action=AUTH_SUCCESS</match>
    <description>MITRE ATT&amp;CK T1110 - Successful SSH Login after/during Brute Force</description>
    <group>authentication_success,syslog,errors,</group>
  </rule>

  <rule id="100004" level="10">
    <if_sid>1002</if_sid>
    <match>MITRE-ATTACK-SIM: T1548.001</match>
    <description>MITRE ATT&amp;CK T1548.001 - SUID Privilege Escalation</description>
    <group>mitre_t1548,syslog,errors,</group>
  </rule>

  <rule id="100005" level="10">
    <if_sid>1002</if_sid>
    <match>MITRE-ATTACK-SIM: T1048</match>
    <description>MITRE ATT&amp;CK T1048 - Exfiltration via DNS</description>
    <group>mitre_t1048,syslog,errors,</group>
  </rule>

</group>
